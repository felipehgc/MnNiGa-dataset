SystemName          mng2
SystemLabel         mng2
Reparametrize.Pseudos T
Restricted.Radial.Grid F
MeshCutoff         400 Ry
%include atoms.fdf
%block kgrid_Monkhorst_Pack
  6  0  0  0.
  0  6  0  0.
  0  0  6  0.
%endblock kgrid_Monkhorst_Pack
%block DM.InitSpin
 1    -0.007440
 2    -0.007432
 3     0.038998
 4    -0.027931
 5     0.005167
 6     0.016053
 7     0.058090
 8     0.057821
 9     0.005313
10     0.024113
11     0.676224
12    -0.062558
13    -0.058244
14    -0.058129
15    -0.008097
16    -0.007923
%endblock DM.InitSpin
MaxSCFIterations     20000
SCF.Mix              Hamiltonian
SCF.Mixer.Method     Broyden
SCF.Mixer.History    8
SCF.Mixer.Weight     0.002
SCF.H.Converge       False
SCF.DM.Converge      True
SCF.DM.Tolerance     5.d-4
SCF.H.Tolerance      5.d-3 eV
MD.UseSaveCG         False
DM.UseSaveDM         False
Occupations           Fermi-Dirac
ElectronicTemperature 300 K
WriteCoorXmol        True
WriteForces          True
WriteMDHistory       True
WriteMDRestart       True
XC.Functional     GGA
XC.authors        PBE
SpinPolarized      True
SolutionMethod       diagon
PAO.BasisSize DZP
#PAO.EnergyShift     0.01 eV
PAO.BasisType       split
#MD.TypeOfRun     CG
#MD.Steps         1000
#MD.MaxForceTol   0.005 eV/Ang
#MD.MaxStressTol  0.5 GPa
#MD.VariableCell  False
Charge.Mulliken  end
Charge.Mulliken.Format 1
SaveRho
%block ProjectedDensityOfStates
   -30.0  30.0  0.05   6000   eV
%endblock ProjectedDensityOfStates
************************** End of input data file *****************************

