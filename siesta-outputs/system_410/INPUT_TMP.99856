SystemName          mng2
SystemLabel         mng2
Reparametrize.Pseudos T
Restricted.Radial.Grid F
MeshCutoff         400 Ry
%include atoms.fdf
%block kgrid_Monkhorst_Pack
  6  0  0  0.
  0  6  0  0.
  0  0  6  0.
%endblock kgrid_Monkhorst_Pack
%block DM.InitSpin
 1 0.01
 2 0.01
 3 0.01
 4 0.01
 5 0.01
 6 0.01
 7 0.01
 8 0.01
 9 0.01
10 0.01
11 0.01
12 0.01
13 0.01
14 0.01
15 0.01
16 0.01
%endblock DM.InitSpin
MaxSCFIterations     20000
SCF.Mix              Hamiltonian
SCF.Mixer.Method     Broyden
SCF.Mixer.History    8
SCF.Mixer.Weight     0.002
SCF.H.Converge       False
SCF.DM.Converge      True
SCF.DM.Tolerance     5.d-4
SCF.H.Tolerance      5.d-3 eV
MD.UseSaveCG         False
DM.UseSaveDM         False
Occupations           Fermi-Dirac
ElectronicTemperature 300 K
WriteCoorXmol        True
WriteForces          True
WriteMDHistory       True
WriteMDRestart       True
XC.Functional     GGA
XC.authors        PBE
SpinPolarized      True
SolutionMethod       diagon
PAO.BasisSize DZP
#PAO.EnergyShift     0.01 eV
PAO.BasisType       split
MD.TypeOfRun     CG
MD.Steps         1000
MD.MaxForceTol   0.005 eV/Ang
MD.MaxStressTol  0.5 GPa
MD.VariableCell  False
Charge.Mulliken  end
Charge.Mulliken.Format 1
SaveRho
%block ProjectedDensityOfStates
   -30.0  30.0  0.01   6000   eV
%endblock ProjectedDensityOfStates
